digraph reaction_paths {
center=1;
s16 -> s2[fontname="Helvetica", penwidth=6, arrowsize=3, color="0.7, 1.5, 0.9"
, label=" 1\l fwd: 3.77\l + O2 (2%)\l \l rev: 2.77\l + H\l"];
s2 [ fontname="Helvetica", label="N2"];
s16 [ fontname="Helvetica", label="NNH"];
 label = "Scale = 0.0015\l Primary PSR N Reaction Paths
NH3=0.50, phi1=1.50, tau=60 ms";
 fontname = "Helvetica";
}
